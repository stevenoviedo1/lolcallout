# AI runs LOCALLY on each player's PC via Ollama (apps/agent). No AI keys on the server.
# See docs/LOCAL_AI.md
OLLAMA_URL=http://127.0.0.1:11434
LOLCOACH_MODEL=lolcoach
LOLCOACH_FALLBACK_MODEL=qwen2.5:3b-instruct
LOLCOACH_KEEP_ALIVE=5m
# Opt-in: save prompt/response pairs to a local JSONL for future fine-tuning (OFF by default)
# LOLCALLOUT_LOG_PAIRS=1
# LOLCALLOUT_PAIRS_FILE=~/.lolcallout/training/pairs.jsonl

# Stripe (lolcallout.com) — one package, everything included
# 1) Secret key from Developers → API keys
# 2) Products (both recurring monthly):
#    - "LOLCallout" $100/mo → STRIPE_PRICE_PRO
#    - "LOLCallout Founders" $50/mo → STRIPE_PRICE_FOUNDERS
# 3) FOUNDERS_ACCESS_MONTHS=6 = months at $50/mo rate from activation (12 when sold out)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FOUNDERS=
FOUNDERS_ACCESS_MONTHS=6
STRIPE_WEBHOOK_SECRET=
APP_URL=https://lolcallout.com

# Auth (magic link)
# APP_URL / AUTH_APP_URL = where user lands after click (desktop: http://127.0.0.1:5173)
AUTH_APP_URL=http://127.0.0.1:5173
API_PUBLIC_URL=http://127.0.0.1:8787
# Resend.com for real emails (optional in dev — link prints to API console)
RESEND_API_KEY=
AUTH_FROM_EMAIL=LOLCallout <onboarding@resend.dev>
# Paid membership (Founders/Pro) still gates AI features in the desktop UI and cloud TTS.
# AUTH_ALLOW_FREE_COACH=1  # eng only — unlock AI for free accounts (never on Railway)
# AUTH_REQUIRE_PAID=1      # legacy flag; paid gate is now default via userHasAccess
# AUTH_DEV_RETURN_LINK=1  # always return magic link in API JSON

# Optional (paid, owner-configured) cloud voice via ElevenLabs. Default voice is the free browser TTS.
# 1) Clone voice at https://elevenlabs.io/app/voice-lab
# 2) Paste API key + voice id
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# API
API_PORT=8787
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Local agent (League Live Client proxy)
AGENT_PORT=3847
AGENT_HOST=127.0.0.1
# false = real play only (recommended). demo = mock until first live game. force = always mock
AGENT_USE_MOCK=false
# Screen capture endpoint (vision is disabled in the desktop while AI runs locally)
AGENT_CAPTURE=false
LIVE_CLIENT_BASE=https://127.0.0.1:2999

# Desktop
VITE_API_URL=http://127.0.0.1:8787
VITE_AGENT_URL=http://127.0.0.1:3847
