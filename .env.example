# SpaceXAI / xAI — server-side only (apps/api)
XAI_API_KEY=your_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
# Optional cheaper/faster model for short callouts
XAI_CALLOUT_MODEL=grok-4.5
# Natural TTS (recommended): eve | ara | leo | rex | sal
XAI_TTS_VOICE=leo
TTS_PROVIDER=xai

# Stripe (lolcallout.com) — one package, everything included
# 1) Secret key from Developers → API keys
# 2) Products (both recurring monthly):
#    - "LOLCallout" $100/mo → STRIPE_PRICE_PRO
#    - "LOLCallout Founders" $50/mo → STRIPE_PRICE_FOUNDERS
# 3) FOUNDERS_ACCESS_MONTHS=6 = months at $50/mo rate from activation (12 when sold out)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FOUNDERS=
FOUNDERS_ACCESS_MONTHS=6
STRIPE_WEBHOOK_SECRET=
APP_URL=https://lolcallout.com

# Auth (magic link)
# APP_URL / AUTH_APP_URL = where user lands after click (desktop: http://127.0.0.1:5173)
AUTH_APP_URL=http://127.0.0.1:5173
API_PUBLIC_URL=http://127.0.0.1:8787
# Resend.com for real emails (optional in dev — link prints to API console)
RESEND_API_KEY=
AUTH_FROM_EMAIL=LOLCallout <onboarding@resend.dev>
# AUTH_REQUIRE_PAID=1  # require founders/pro to use coach (prod)
# AUTH_DEV_RETURN_LINK=1  # always return magic link in API JSON

# Optional: YOUR cloned voice via ElevenLabs
# 1) Clone voice at https://elevenlabs.io/app/voice-lab
# 2) Paste API key + voice id
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# API
API_PORT=8787
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Local agent (League Live Client proxy)
AGENT_PORT=3847
AGENT_HOST=127.0.0.1
# false = real play only (recommended). demo = mock until first live game. force = always mock
AGENT_USE_MOCK=false
# Opt-in primary-monitor capture for vision coaching
AGENT_CAPTURE=true
LIVE_CLIENT_BASE=https://127.0.0.1:2999

# Desktop
VITE_API_URL=http://127.0.0.1:8787
VITE_AGENT_URL=http://127.0.0.1:3847
