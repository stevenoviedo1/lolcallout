# LOLCallout API only — skips Electron/desktop so Railway Linux builds succeed
FROM node:22-bookworm-slim

WORKDIR /app

# Root manifests
COPY package.json package-lock.json tsconfig.base.json ./

# Workspace package.json files (stubs for unused apps so npm workspaces resolve)
COPY packages/shared/package.json ./packages/shared/
COPY packages/prompts/package.json ./packages/prompts/
COPY apps/api/package.json ./apps/api/
# Minimal stubs — monorepo workspaces[] expects these folders
RUN mkdir -p apps/desktop apps/web apps/agent packages/_stub \
 && printf '%s\n' '{"name":"@riftcoach/desktop","private":true,"version":"0.0.0"}' > apps/desktop/package.json \
 && printf '%s\n' '{"name":"@riftcoach/web","private":true,"version":"0.0.0"}' > apps/web/package.json \
 && printf '%s\n' '{"name":"@riftcoach/agent","private":true,"version":"0.0.0"}' > apps/agent/package.json

# Install only API + shared + prompts (includes TypeScript for build)
RUN npm install --include=dev \
  -w @riftcoach/shared \
  -w @riftcoach/prompts \
  -w @riftcoach/api \
  --include-workspace-root \
  --no-audit \
  --no-fund

# Source for packages we actually build
COPY packages/shared ./packages/shared
COPY packages/prompts ./packages/prompts
COPY apps/api ./apps/api

RUN npm run build -w @riftcoach/shared \
 && npm run build -w @riftcoach/prompts \
 && npm run build -w @riftcoach/api

ENV NODE_ENV=production
ENV PORT=8787
# Mount a Railway volume at /data and set DATA_DIR=/data so accounts persist across deploys.
# ENV DATA_DIR=/data
# Restore Pro for product owner if volume is empty / first boot
ENV BOOTSTRAP_PRO_EMAILS=steven.oviedo1@gmail.com:24
EXPOSE 8787

CMD ["npm", "run", "start", "-w", "@riftcoach/api"]
