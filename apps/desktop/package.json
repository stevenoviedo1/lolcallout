{
  "name": "@riftcoach/desktop",
  "version": "0.3.7",
  "private": true,
  "description": "LOLCallout — live AI coach for League of Legends",
  "author": "LOLCallout",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "companion": "npx --yes electron electron/main.cjs",
    "pack:win": "powershell -ExecutionPolicy Bypass -File ../../scripts/pack-release.ps1",
    "electron:dev": "electron electron/main.cjs",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@riftcoach/shared": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "build": {
    "appId": "com.lolcallout.app",
    "productName": "LOLCallout",
    "copyright": "Copyright © LOLCallout",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release-pack/server",
        "to": "server"
      },
      {
        "from": "release-pack/ui",
        "to": "ui"
      },
      {
        "from": "release-pack/playtest.env",
        "to": "playtest.env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LOLCallout-${version}.${ext}",
      "publisherName": "LOLCallout",
      "signingHashAlgorithms": ["sha256"],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "LOLCallout.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LOLCallout",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "LOLCallout-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "LOLCallout",
        "schemes": ["lolcallout"]
      }
    ]
  }
}
